{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0-rtm.5.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {
              "id": "java/sql-injection",
              "name": "SQL Injection",
              "shortDescription": {
                "text": "Query built from user-controlled sources"
              },
              "help": {
                "markdown": "Building a SQL query from user-controlled sources is vulnerable to SQL injection."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "java/sql-injection",
          "level": "error",
          "message": {
            "text": "This query depends on a user-provided value."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sdm/src/main/java/com/sap/cds/sdm/service/DocumentService.java"
                },
                "region": {
                  "startLine": 45,
                  "endLine": 45
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
